# Sao chép file này thành ".env" rồi điền thông tin của bạn. KHÔNG commit/chia sẻ file .env.

# ---- DataStax Astra DB ----
# Đường dẫn tới Secure Connect Bundle (file .zip tải từ Astra: Database > Connect > Python)
ASTRA_DB_BUNDLE=./secure-connect-weather.zip
# Application Token (bắt đầu bằng AstraCS:...) tạo ở Settings > Token Management
ASTRA_DB_TOKEN=AstraCS:xxxxxxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tên keyspace đã tạo trong Astra
ASTRA_KEYSPACE=weather

# ---- (Tuỳ chọn) Cassandra cài trên máy: bỏ trống ASTRA_DB_BUNDLE và dùng 2 dòng dưới ----
# CASSANDRA_HOSTS=127.0.0.1
# CASSANDRA_PORT=9042
